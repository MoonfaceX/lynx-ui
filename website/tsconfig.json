{
  "extends": [
    "@tsconfig/strictest/tsconfig",
  ],
  "compilerOptions": {
    "target": "ES2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@site/*": ["./*"],
      "@lynx/*": ["./src/lynx-ui/components/*"],
      "@i18n": ["./i18n.json"],
      "@assets/*": ["./docs/public/assets/*"],
      "@docs/*": ["./sharedDocs/packageDocs/*"],
    },
    "jsx": "react",
  },
  "mdx": {
    "checkMdx": true,
  },
  "include": [
    "src/**/*",
    "theme/**/*",
    "global.d.ts",
  ],
}
